{
  "name": "emisor-casa-cambio",
  "version": "1.1.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "author": {
    "name": "Casa Cambio",
    "email": "info@casacambio.com"
  },
  "license": "ISC",
  "description": "Emisor de Casa de Cambio",
  "build": {
    "appId": "com.casacambio.emisor3",
    "productName": "Emisor CasaCambio",
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "EmisorCasaCambio-Setup.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "axios": "^1.20.0"
  }
}
